---
# Broad groups, and out of them what contradicts the Google style or cannot
# be had on the AVR. Each exception says why.
Checks: >
  bugprone-*,
  clang-analyzer-*,
  google-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-dynamic-static-initializers,
  -google-explicit-constructor,
  -misc-explicit-constructor,
  -modernize-deprecated-headers,
  -modernize-return-braced-init-list,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-named-parameter
# bugprone-dynamic-static-initializers: it reports the extern declaration of
#   every group, as it cannot see the constexpr definition in the .cpp. A
#   group has to be extern, its address being what identifies it, so only a
#   NOLINT in every group, a sketch's own as well, would silence it.
# google-explicit-constructor, misc-explicit-constructor: cpplint checks the
#   same rule as runtime/explicit, and the implicit constructors that are
#   meant carry their NOLINT there; two tools would want two per line.
# modernize-deprecated-headers: avr-gcc comes without a C++ standard library,
#   so there is no <cstdint>, only <stdint.h>.
# modernize-return-braced-init-list: `return Error();` says that no error is
#   returned, `return {};` hides it.
# modernize-use-trailing-return-type: Google puts the return type in front.
# readability-identifier-length: Google allows `f` or `a` and `b` where the
#   scope is a few lines.
# readability-named-parameter: Google leaves out the name of a parameter that
#   is unused where the context explains it, as the enum that only picks the
#   overload of GetErrorGroup().
WarningsAsErrors: '*'
# The Doxygen blocks, checked against the declaration they stand at: a \param
# whose name the function does not have, a \return on a function that returns
# nothing, an unknown command. \stddiff is the alias of the Doxyfile. See
# docs/Documentation.md; .clangd adds the same, so the editor shows them.
ExtraArgs:
  - -Wdocumentation
  - -Wdocumentation-unknown-command
  - -fcomment-block-commands=stddiff
# (^|/), as tools/tidy.sh names the files relative to the repository, and a
# header beside an example is found as examples/.../font_error.h.
HeaderFilterRegex: '(^|/)(src|examples)/'
CheckOptions:
  # A text in PROGMEM is a char array: F() and the tables of the groups need
  # one. Any other array is a utl::array.
  modernize-avoid-c-arrays.AllowStringArrays: true
  # A struct with only public members is what Google calls a struct, and
  # utl::array has to be one to stay an aggregate.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # Google's "include what you use", with Arduino.h as what provides the
  # core: F(), __FlashStringHelper and the rest come through it.
  misc-include-cleaner.IgnoreHeaders: '.*/cores/arduino/.*'
  # Google's names, which readability-identifier-naming checks only once it is
  # told them; the same block lies in MaxMatrix and Wordclock, so that every
  # project names alike. Three exceptions Google makes itself: an entity that
  # mimics one of the standard library takes its names (array, span,
  # optional, reference_wrapper, function_ref, inplace_function, string_view:
  # utl::array, ref(), size(), value_type, npos); an accessor is named like
  # the variable it gives (group(), code(), error()); and an include guard
  # ends in an underscore.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.ClassIgnoredRegexp: '^(array|span|optional|reference_wrapper|function_ref|inplace_function|basic_string_view|string_view|basic_flash_string_view|flash_string_view|const_iterator|iterator)$'
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.StructIgnoredRegexp: '^(array|nullopt_t|is_[a-z_]+|remove_[a-z_]+|enable_if|integral_constant|true_type|false_type)$'
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TypedefIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp: '^(make_array|ref|cref|to_chars|from_chars|swap|begin|end)$'
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.MethodIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: '^(npos|nullopt|value)$'
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^[A-Z][A-Z0-9_]*_$'
